# SentinelSwarm — Configuration Template (Copy to config.env and fill values)

# ── Network Settings ──
LAPTOP_A_IP=127.0.0.1
LAPTOP_B_IP=127.0.0.1
LAPTOP_C_IP=127.0.0.1

# ── Target Company Service Config ──
COMPANY_SITE_PORT=5000
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SSH_HONEYPOT_PORT=2222
SSH_HONEYPOT_USER=sshuser
SSH_HONEYPOT_PASS=your_password
ACTION_RECEIVER_PORT=5001
ACTION_RECEIVER_SECRET=your_secret

# ── SentinelSwarm Backend & Dashboard ──
BACKEND_PORT=8000
DASHBOARD_PORT=5173
CONTEXT_BUS_DB=context_bus.db
NGROK_URL=https://your-ngrok-url.ngrok-free.app

# ── Attacker Config ──
EXFIL_LISTENER_PORT=9000

# ── LLM API Keys ──
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# ── Twilio Config ──
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TEAM_LEAD_WHATSAPP=whatsapp:+910000000000
TEAM_LEAD_VOICE=+910000000000
TWILIO_VOICE_FROM=+10000000000

# ── x402 / Base Sepolia ──
AGENT_WALLET_ADDRESS=your_wallet_address
AGENT_WALLET_PRIVATE_KEY=your_private_key
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=

# ── Voice / Speech Synthesis ──
SARVAM_API_KEY=your_sarvam_api_key

# ── x402 / Algorand Config ──
ALGORAND_NETWORK=testnet
PAY_TO_ADDRESS=your_pay_to_address
CLIENT_MNEMONIC="your_mnemonic_words_here"
WALLET_ADDRESS=your_wallet_address
COMMERCE_AGENT_ADDRESS=your_commerce_agent_address
COMMERCE_AGENT_PRIVATE_KEY=your_commerce_agent_private_key
X402_ALGORAND_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
FACILITATOR_URL=https://facilitator.goplausible.xyz
DEMO_MODE=true
